{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // If we even add another package meant to be consumed in the browser, consider making a separate tsconfig for it.
  // `packages/elements` run in the browser and check with DOM types in their own tsconfig.
  "exclude": ["**/node_modules", "packages/elements"]
}
