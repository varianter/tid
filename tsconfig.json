{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // Packages that run in the browser check with DOM types in their own tsconfig, and their own
  // typecheck script.
  "exclude": ["**/node_modules", "packages/elements", "packages/via"]
}
