{
  "name": "@tid/web",
  "type": "module",
  "scripts": {
    "dev": "bun src/dev.ts",
    "build": "bun build src/server.tsx --outfile dist/server.js --target bun",
    "start": "bun dist/server.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint && bun run test"
