  "dependencies": {
    "@tid/db": "workspace:*",
    "@tid/ui": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "4.13.9",
    "openid-client": "6.8.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
