{
  "name": "@tid/web",
  "type": "module",
  "scripts": {
    "dev": "bun src/dev.ts",
    "download-icons": "bun scripts/download-icons.ts",
    "build": "bun build src/server.tsx --outfile dist/server.js --target bun",
    "start": "bun dist/server.js",
    "test": "bun test",
    "typecheck": "bun check --no-pretty",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@tid/calendar": "workspace:*",
    "@tid/db": "workspace:*",
    "@tid/elements": "workspace:*",
    "@tid/harvest": "workspace:*",
    "@tid/ui": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "4.13.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2"
  }
}
